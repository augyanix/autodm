VERIFY_TOKEN=pick-any-random-string
# Meta app secret: App settings > Basic (not an Instagram-specific secret)
APP_SECRET=
ACCESS_TOKEN=
# From ./scripts/meta.sh id
IG_USER_ID=
# Optional: FOLLOW_CHECK=off skips Meta's follow lookup if it is refused (they just tap the button)
# Only for the optional HTTPS profile:
DOMAIN=
